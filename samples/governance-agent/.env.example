# --- Authentication (one of the two modes is REQUIRED; the app refuses to start otherwise) ---
# Mode 1: Google OAuth ("Login with Google"). Each user acts with their own credentials.
GOOGLE_REDIRECT_URI=http://localhost:7860/google_callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Secret used to sign session cookies. Set a long random value in production
# (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`) so sessions
# survive restarts and work across multiple instances.
SESSION_SECRET_KEY=

# Mode 2: ADC mode. Every visitor acts as the server's Application Default Credentials
# (Service Account). Only for local development or behind an authenticating proxy (IAP).
# BYPASS_OAUTH=true

# Optional: Writable BigQuery dataset for storing business glossary embeddings cache.
# Essential when scanning read-only datasets where the steward lacks write permissions.
# GLOSSARY_CACHE_DATASET_ID=your_cache_dataset_id

# Optional: Custom table name for glossary embeddings cache (defaults to glossary_embeddings_cache)
# GLOSSARY_CACHE_TABLE_ID=glossary_embeddings_cache