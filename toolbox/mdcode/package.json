{
  "name": "@google-cloud/kcmd",
  "version": "0.2.4",
  "description": "Google Knowledge Catalog Metadata as Code Library, CLI and MCP Server",
  "repository": {
    "type": "git",
    "url": "https://github.com/GoogleCloudPlatform/knowledge-catalog.git",
    "directory": "toolbox/mdcode"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./build/ts/kcmd/index.js",
  "bin": {
    "kcmd": "./build/ts/kcmd/cli.js"
  },
  "types": "./build/ts/kcmd/index.d.ts",
  "exports": {
    ".": "./build/ts/kcmd/index.js"
  },
  "files": [
    "build/ts/kcmd/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:libts": "node -e \"require('fs').rmSync('build/ts/kcmd',{recursive:true,force:true})\" && npx tsc -p src/libts/tsconfig.json",
    "build:cli": "node -e \"const cp=require('child_process');let sha='';try{sha=cp.execSync('git rev-parse --short HEAD',{stdio:['ignore','pipe','ignore']}).toString().trim()}catch{}cp.execFileSync('npx',['bun','build','--target=node','--format=cjs','--packages=external','--define','__KCMD_ENABLE_SEMANTIC__=false','--define','__KCMD_COMMIT__='+JSON.stringify(sha),'--banner=#!/usr/bin/env node','--outfile','build/ts/kcmd/cli.js','src/tool/main.ts'],{stdio:'inherit'});require('fs').chmodSync('build/ts/kcmd/cli.js',0o755)\"",
    "build:tool": "node -e \"const cp=require('child_process');let sha='';try{sha=cp.execSync('git rev-parse --short HEAD',{stdio:['ignore','pipe','ignore']}).toString().trim()}catch{}cp.execFileSync('npx',['bun','build','--compile','--define','__KCMD_COMMIT__='+JSON.stringify(sha),'--outfile','dist/kcmd','src/tool/main.ts'],{stdio:'inherit'})\"",
    "build": "npm run build:libts && npm run build:cli && npm run build:tool",
    "pack:semantic": "node scripts/pack-semantic.mjs",
    "compile": "npx tsc --noEmit",
    "test:libts": "npx bun test ./tests/libts/scenarios.ts && npx bun test ./tests/libts/layouts/ ./tests/libts/okf/",
    "test:semantic": "npx bun test ./tests/libts/semantic/",
    "test:semantic-pkg": "npx bun test ./tests/tool/semantic_package_e2e.ts",
    "test:tool": "npx bun test ./tests/tool/",
    "test:gcp": "npx bun test ./tests/libts/gcp/",
    "test": "npm run test:libts && npm run test:gcp && npm run test:semantic && npm run test:tool",
    "x:mcp": "npx @modelcontextprotocol/inspector dist/kcmd mcp"
  },
  "keywords": [],
  "author": "Google LLC",
  "license": "Apache-2.0",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@polyglot-sql/sdk": "^0.9.1",
    "cac": "^7.0.0",
    "glob": "^13.0.6",
    "n3": "^2.2.5",
    "yaml": "^2.8.4",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.21.2",
    "@types/bun": "^1.3.14",
    "@types/n3": "^1.26.1",
    "@types/node": "^25.6.0",
    "ajv": "^8.17.1",
    "bun": "^1.3.14",
    "bun-types": "^1.3.14",
    "google-artifactregistry-auth": "3.5.0",
    "memfs": "^4.57.2",
    "typescript": "^6.0.3"
  }
}
