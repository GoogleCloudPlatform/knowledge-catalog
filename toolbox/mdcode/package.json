{
  "name": "@google-cloud/kcmd",
  "version": "0.1.0",
  "description": "Google Knowledge Catalog Metadata as Code Library, CLI and MCP Server",
  "repository": {
    "type": "git",
    "url": "https://github.com/GoogleCloudPlatform/knowledge-catalog.git",
    "directory": "toolbox/mdcode"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./build/ts/kcmd/index.js",
  "bin": {
    "kcmd": "./build/ts/kcmd/cli.js"
  },
  "types": "./build/ts/kcmd/index.d.ts",
  "exports": {
    ".": "./build/ts/kcmd/index.js"
  },
  "files": [
    "build/ts/kcmd/",
    "README.md"
  ],
  "scripts": {
    "build:libts": "npx tsc -p src/libts/tsconfig.json",
    "build:cli": "npx bun build --target=node --format=cjs --packages=external --banner=\"#!/usr/bin/env node\" --outfile build/ts/kcmd/cli.js src/tool/main.ts && node -e \"require('fs').chmodSync('build/ts/kcmd/cli.js', 0o755)\"",
    "build:tool": "npx bun build --compile --outfile dist/kcmd src/tool/main.ts",
    "build": "npm run build:libts && npm run build:cli && npm run build:tool",
    "compile": "npx tsc --noEmit",
    "test:libts": "npx bun test ./tests/libts/scenarios.ts && npx bun test ./tests/libts/layouts/",
    "test:semantic": "npx bun test ./tests/libts/semantic/",
    "test:tool": "npx bun test ./tests/tool/",
    "test:gcp": "npx bun test ./tests/libts/gcp/",
    "test": "npm run test:libts && npm run test:gcp && npm run test:semantic && npm run test:tool",
    "x:mcp": "npx @modelcontextprotocol/inspector dist/kcmd mcp"
  },
  "keywords": [],
  "author": "Google LLC",
  "license": "Apache-2.0",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@polyglot-sql/sdk": "^0.9.1",
    "cac": "^7.0.0",
    "glob": "^13.0.6",
    "n3": "^2.2.5",
    "yaml": "^2.8.4",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.21.2",
    "@types/bun": "^1.3.14",
    "@types/n3": "^1.26.1",
    "@types/node": "^25.6.0",
    "ajv": "^8.17.1",
    "bun": "^1.3.14",
    "bun-types": "^1.3.14",
    "memfs": "^4.57.2",
    "typescript": "^6.0.3"
  }
}
