{
  "name": "okf",
  "type": "record",
  "recordFields": [
    {
      "index": 1,
      "name": "okf_type",
      "type": "string",
      "annotations": {
        "displayName": "OKF Type",
        "description": "The OKF document type (freeform, e.g. 'BigQuery Dataset').",
        "search": {
          "retrievable": true
        }
      }
    },
    {
      "index": 2,
      "name": "generated",
      "type": "record",
      "recordFields": [
        {
          "index": 1,
          "name": "by",
          "type": "string",
          "annotations": {
            "displayName": "Generated By",
            "description": "Actor that generated the document (e.g. 'reference_agent/gemini-2.5-pro')."
          }
        },
        {
          "index": 2,
          "name": "at",
          "type": "string",
          "annotations": {
            "displayName": "Generated At",
            "description": "ISO 8601 timestamp of the content's last meaningful change."
          }
        }
      ],
      "annotations": {
        "displayName": "Generated",
        "description": "How the current content was produced."
      }
    },
    {
      "index": 3,
      "name": "sources",
      "type": "array",
      "arrayItems": {
        "name": "source",
        "type": "record",
        "recordFields": [
          {
            "index": 1,
            "name": "id",
            "type": "string",
            "annotations": {
              "displayName": "Source ID",
              "description": "Footnote identifier referenced from the body as [^id]."
            }
          },
          {
            "index": 2,
            "name": "resource",
            "type": "string",
            "constraints": {
              "required": true
            },
            "annotations": {
              "displayName": "Resource",
              "description": "URI of the source, or a path to another concept in the bundle."
            }
          },
          {
            "index": 3,
            "name": "title",
            "type": "string",
            "annotations": {
              "displayName": "Title",
              "description": "Human-readable title of the source."
            }
          },
          {
            "index": 4,
            "name": "author",
            "type": "string",
            "annotations": {
              "displayName": "Author",
              "description": "Actor responsible for the source (e.g. 'team:data-platform')."
            }
          },
          {
            "index": 5,
            "name": "usage_count",
            "type": "int",
            "annotations": {
              "displayName": "Usage Count",
              "description": "How often the source was used over the usage window."
            }
          },
          {
            "index": 6,
            "name": "last_modified",
            "type": "string",
            "annotations": {
              "displayName": "Last Modified",
              "description": "ISO 8601 timestamp of the source's own last change."
            }
          }
        ]
      },
      "annotations": {
        "displayName": "Sources",
        "description": "Materials the concept derives from, with credibility signals."
      }
    },
    {
      "index": 4,
      "name": "verified",
      "type": "array",
      "arrayItems": {
        "name": "verification",
        "type": "record",
        "recordFields": [
          {
            "index": 1,
            "name": "by",
            "type": "string",
            "annotations": {
              "displayName": "Verified By",
              "description": "Actor that confirmed the content (e.g. 'human:jsmith@acme')."
            }
          },
          {
            "index": 2,
            "name": "at",
            "type": "string",
            "annotations": {
              "displayName": "Verified At",
              "description": "ISO 8601 timestamp of the verification."
            }
          }
        ]
      },
      "annotations": {
        "displayName": "Verified",
        "description": "Verification events. A 'human:' actor marks the highest trust tier."
      }
    },
    {
      "index": 5,
      "name": "status",
      "type": "string",
      "annotations": {
        "displayName": "Status",
        "description": "Lifecycle state: draft, stable, or deprecated. Absent means stable.",
        "search": {
          "retrievable": true
        }
      }
    },
    {
      "index": 6,
      "name": "stale_after",
      "type": "string",
      "annotations": {
        "displayName": "Stale After",
        "description": "ISO 8601 timestamp on or after which the content is stale."
      }
    },
    {
      "index": 7,
      "name": "usage_window",
      "type": "record",
      "recordFields": [
        {
          "index": 1,
          "name": "from",
          "type": "string",
          "annotations": {
            "displayName": "From",
            "description": "ISO 8601 timestamp the window starts at."
          }
        },
        {
          "index": 2,
          "name": "to",
          "type": "string",
          "annotations": {
            "displayName": "To",
            "description": "ISO 8601 timestamp the window ends at."
          }
        }
      ],
      "annotations": {
        "displayName": "Usage Window",
        "description": "Period the source usage counts were measured over."
      }
    },
    {
      "index": 8,
      "name": "runtime",
      "type": "string",
      "annotations": {
        "displayName": "Runtime",
        "description": "How an Attested Computation runs (e.g. 'bigquery'). Defines what parameters mean.",
        "search": {
          "retrievable": true
        }
      }
    },
    {
      "index": 9,
      "name": "parameters",
      "type": "array",
      "arrayItems": {
        "name": "parameter",
        "type": "record",
        "recordFields": [
          {
            "index": 1,
            "name": "name",
            "type": "string",
            "annotations": {
              "displayName": "Name",
              "description": "Parameter name."
            }
          },
          {
            "index": 2,
            "name": "type",
            "type": "string",
            "annotations": {
              "displayName": "Type",
              "description": "Parameter type, interpreted per runtime."
            }
          },
          {
            "index": 3,
            "name": "required",
            "type": "bool",
            "annotations": {
              "displayName": "Required",
              "description": "Whether the caller must supply a value."
            }
          }
        ]
      },
      "annotations": {
        "displayName": "Parameters",
        "description": "The typed, named holes a caller may fill. The only surface a caller may vary."
      }
    },
    {
      "index": 10,
      "name": "computation",
      "type": "string",
      "annotations": {
        "displayName": "Computation",
        "description": "Path to a file holding the computation, used instead of an inline body fence."
      }
    },
    {
      "index": 11,
      "name": "executor",
      "type": "record",
      "recordFields": [
        {
          "index": 1,
          "name": "resource",
          "type": "string",
          "annotations": {
            "displayName": "Resource",
            "description": "Run instructions or code a runner follows."
          }
        },
        {
          "index": 2,
          "name": "receipt",
          "type": "array",
          "arrayItems": {
            "name": "field",
            "type": "string"
          },
          "annotations": {
            "displayName": "Receipt Fields",
            "description": "Fields a run must return as evidence for the attester."
          }
        }
      ],
      "annotations": {
        "displayName": "Executor",
        "description": "How the computation is run and what evidence a run must return."
      }
    },
    {
      "index": 12,
      "name": "attester",
      "type": "record",
      "recordFields": [
        {
          "index": 1,
          "name": "resource",
          "type": "string",
          "annotations": {
            "displayName": "Resource",
            "description": "Deterministic code (no LLM) that takes a receipt and returns a verdict."
          }
        }
      ],
      "annotations": {
        "displayName": "Attester",
        "description": "The consumer-side check that the sanctioned computation is what actually ran."
      }
    },
    {
      "index": 13,
      "name": "extra",
      "type": "string",
      "annotations": {
        "displayName": "Extra Frontmatter",
        "description": "Producer-defined frontmatter this template does not model, as a JSON list of [path, value] pairs where a path is a list of record field names and list indices. OKF allows arbitrary extra keys at any depth, so no enumerated template can be complete; keeping them here makes the round-trip lossless."
      }
    }
  ],
  "annotations": {
    "displayName": "OKF Signal",
    "description": "Open Knowledge Format v0.2 signal layer: type, provenance, trust, lifecycle, and computation contract."
  }
}
