# An ontology exercising namespace-aware carriage (see the user guide's
# "Constructs carried as custom extensions"). Its base namespace is
# http://example.com/people# (ex:); it also references the external FOAF and
# schema.org vocabularies. The mapper carries a cross-reference verbatim as the
# FULL IRI when it points OUTSIDE this ontology, and shortens it to a local name
# when it points at an ex: term:
#   - owl:equivalentClass foaf:Person   -> full IRI (cross-namespace)
#   - owl:disjointWith ex:Robot         -> "Robot" (in-namespace, shortened)
#   - owl:equivalentProperty foaf:name  -> full IRI
#   - owl:propertyDisjointWith ex:relatedTo -> "relatedTo" (shortened)
# Plus the per-term annotations (rdfs:seeAlso / isDefinedBy kept verbatim,
# owl:deprecated / versionInfo) and the reflexive / irreflexive / asymmetric
# property characteristics. Carriage is inert on push and lossless on pull.

@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ex:   <http://example.com/people#> .

# Person is equivalent to the EXTERNAL foaf:Person (carried as a full IRI) and
# disjoint with the IN-NAMESPACE ex:Robot (carried as the local name "Robot").
# rdfs:seeAlso / rdfs:isDefinedBy point outside the model, so they ride verbatim.
ex:Person a owl:Class ;
    rdfs:comment "A human being." ;
    owl:equivalentClass foaf:Person ;
    owl:disjointWith ex:Robot ;
    rdfs:seeAlso <https://schema.org/Person> ;
    rdfs:isDefinedBy <http://example.com/people> ;
    owl:hasKey ( ex:personId ) .
ex:Robot a owl:Class ;
    rdfs:comment "A machine, never a person." .

ex:personId a owl:DatatypeProperty ;
    rdfs:domain ex:Person ; rdfs:range xsd:string .

# legalName is equivalent to the external foaf:name (full IRI), single-valued
# (owl:FunctionalProperty), deprecated, versioned, and carries a literal
# seeAlso note.
ex:legalName a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain ex:Person ; rdfs:range xsd:string ;
    owl:equivalentProperty foaf:name ;
    rdfs:seeAlso "See the naming policy doc." ;
    owl:deprecated true ;
    owl:versionInfo "2.0" .

# ancestorOf chains and is one-directional: transitive + irreflexive +
# asymmetric. It is disjoint with the in-namespace relatedTo (-> "relatedTo").
ex:ancestorOf a owl:ObjectProperty, owl:TransitiveProperty,
                owl:IrreflexiveProperty, owl:AsymmetricProperty ;
    rdfs:domain ex:Person ; rdfs:range ex:Person ;
    owl:propertyDisjointWith ex:relatedTo ;
    rdfs:isDefinedBy <http://example.com/people> .

# relatedTo holds both ways and of everyone with themselves: symmetric +
# reflexive. It is equivalent to the external foaf:knows (full IRI).
ex:relatedTo a owl:ObjectProperty, owl:SymmetricProperty, owl:ReflexiveProperty ;
    rdfs:domain ex:Person ; rdfs:range ex:Person ;
    owl:equivalentProperty foaf:knows .
